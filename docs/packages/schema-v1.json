{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/civarry/lasso-app/main/docs/packages/schema-v1.json",
  "title": "Lasso package, format version 1",
  "description": "See docs/PACKAGES.md. Lasso itself is the final check: it also verifies templates, hosts and what this version of Lasso can run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lasso",
    "id",
    "version",
    "name",
    "summary",
    "author"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "lasso": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://"
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        }
      }
    },
    "category": {
      "enum": [
        "search",
        "knowledge",
        "productivity",
        "writing",
        "developer",
        "media",
        "fun"
      ]
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,62}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,62}[A-Za-z0-9])?)+$"
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "kind": {
            "enum": [
              "secret",
              "text",
              "choice",
              "toggle",
              "server",
              "folder"
            ]
          },
          "help": {
            "type": "string",
            "pattern": "^https://"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "default": {
            "type": [
              "string",
              "boolean"
            ]
          }
        }
      }
    },
    "requires": {
      "type": "array",
      "maxItems": 8,
      "description": "What must be installed. Lasso checks it and never installs it.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "description": "A program on Lasso's PATH, like pandoc"
          },
          "install": {
            "type": "string",
            "maxLength": 200,
            "description": "The line that installs it, shown to the user"
          },
          "app": {
            "type": "string",
            "description": "An app's bundle id, like com.apple.Notes"
          }
        },
        "oneOf": [
          {
            "required": [
              "command"
            ]
          },
          {
            "required": [
              "app"
            ]
          }
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daily": {
          "type": "integer",
          "minimum": 1
        },
        "monthly": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "minLasso": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "surfaces",
          "run",
          "output"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "symbol": {
            "type": "string",
            "description": "An SF Symbol name"
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "toolbar",
                "send",
                "slash",
                "tool",
                "search",
                "hotkey",
                "event"
              ]
            }
          },
          "input": {
            "type": "array",
            "items": {
              "enum": [
                "text",
                "image",
                "source",
                "query",
                "args",
                "table",
                "lines"
              ]
            }
          },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "match": {
                "type": "string",
                "maxLength": 200
              },
              "detects": {
                "type": "array",
                "items": {
                  "enum": [
                    "link",
                    "email",
                    "phone",
                    "address",
                    "date",
                    "flight",
                    "tracking",
                    "money",
                    "table"
                  ]
                }
              },
              "apps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "minLength": {
                "type": "integer"
              },
              "maxLength": {
                "type": "integer"
              },
              "hasImage": {
                "type": "boolean"
              }
            }
          },
          "run": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "http": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url"
                ],
                "properties": {
                  "method": {
                    "enum": [
                      "GET",
                      "POST"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "description": "https URL on a declared host, or {{settings.<server>}}/path"
                  },
                  "query": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "json": {
                    "description": "Request body; string values may contain {{templates}}"
                  },
                  "form": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "timeout": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 20
                  }
                }
              },
              "prompt": {
                "type": "string",
                "maxLength": 4000
              },
              "system": {
                "type": "string",
                "maxLength": 1000
              },
              "shortcut": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "get": {
                    "type": "string",
                    "pattern": "^https://www\\.icloud\\.com/shortcuts/"
                  },
                  "offline": {
                    "type": "boolean"
                  },
                  "timeout": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 120
                  }
                }
              },
              "script": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^scripts/"
                  },
                  "network": {
                    "type": "boolean"
                  },
                  "timeout": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 300
                  }
                }
              },
              "results": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "list",
                  "title"
                ],
                "properties": {
                  "list": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "snippet": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                }
              },
              "answer": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "primary",
                  "reserve"
                ]
              }
            },
            "oneOf": [
              {
                "required": [
                  "http"
                ]
              },
              {
                "required": [
                  "prompt"
                ]
              },
              {
                "required": [
                  "shortcut"
                ]
              },
              {
                "required": [
                  "script"
                ]
              }
            ]
          },
          "output": {
            "enum": [
              "markdown",
              "copy",
              "replace",
              "open",
              "image",
              "file",
              "notify",
              "results"
            ]
          },
          "tool": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,39}$"
              },
              "description": {
                "type": "string",
                "maxLength": 200
              },
              "args": {
                "type": "object",
                "maxProperties": 6,
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                },
                "additionalProperties": {
                  "enum": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          },
          "test": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "query": {
                "type": "string"
              },
              "args": {
                "type": "object"
              },
              "image": {
                "type": "string"
              }
            }
          },
          "howTo": {
            "type": "string",
            "maxLength": 140,
            "description": "One line on how to use it, shown in How to use it (Markdown bold allowed)"
          },
          "on": {
            "type": "array",
            "items": {
              "enum": [
                "capture",
                "reply"
              ]
            },
            "minItems": 1,
            "description": "For the event surface: what it runs on"
          },
          "hook": {
            "enum": [
              "source/1",
              "describe/1"
            ],
            "description": "A hook (docs/PACKAGE-HOOKS.md): source/1 on a search command gets the whole turn; describe/1 writes What's in it"
          },
          "ranks": {
            "type": "boolean",
            "description": "With source/1: the command judges its results' relevance instead of Lasso's word gate"
          }
        }
      }
    },
    "patches": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "enum": [
              "action.ai.summarize.prompt",
              "action.ai.grammar.prompt",
              "action.ocr.copy.title",
              "action.translate.title",
              "action.ai.grammar.title",
              "action.ai.summarize.title",
              "action.ai.ask.title",
              "action.qr.open.title",
              "action.color.pick.title",
              "action.identify.title",
              "action.lens.search.title",
              "toolbar.order",
              "toolbar.hidden",
              "chat.suggestions",
              "chat.instructions",
              "chat.greeting",
              "chat.placeholder",
              "action.ocr.copy.symbol",
              "action.translate.symbol",
              "action.ai.grammar.symbol",
              "action.ai.summarize.symbol",
              "action.ai.ask.symbol",
              "action.qr.open.symbol",
              "action.color.pick.symbol",
              "action.identify.symbol",
              "action.lens.search.symbol"
            ],
            "description": "What to change. The list with Lasso's own values is in docs/patch-targets.md."
          },
          "set": {},
          "add": {},
          "remove": {}
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "set"
            ]
          },
          {
            "required": [
              "add"
            ]
          },
          {
            "required": [
              "remove"
            ]
          }
        ]
      },
      "minItems": 1
    }
  },
  "anyOf": [
    {
      "required": [
        "commands"
      ]
    },
    {
      "required": [
        "patches"
      ]
    }
  ]
}
