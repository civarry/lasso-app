<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Lasso</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<!-- Allow plain-HTTP requests to the local Ollama server (http://localhost:11434).
	     App Transport Security blocks cleartext HTTP by default; NSAllowsLocalNetworking
	     exempts loopback/.local so URLSession can reach Ollama. All traffic stays on this Mac. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSHumanReadableCopyright</key>
	<string>Lasso — on-device screen intelligence.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Lasso captures the screen so you can select a region to OCR, translate, scan, and act on. Capture happens on-device; nothing leaves your Mac unless you explicitly use a cloud feature.</string>
	<key>NSCameraUsageDescription</key>
	<string>Not used by Lasso core features.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Only used if you enable song identification.</string>
</dict>
</plist>
