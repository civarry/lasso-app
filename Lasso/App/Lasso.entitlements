<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Lasso v1 is distributed Developer ID + notarized, NON-sandboxed.
	  Screen Recording is granted via TCC at runtime, not via an entitlement.
	  Sandbox is explicitly disabled so global hotkeys + ScreenCaptureKit +
	  localhost (Ollama) work without sandbox friction (see Spec §13).
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Hardened runtime blocks the microphone without this; chat voice input needs it. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!--
	  Releases are signed with a self-signed certificate, which has no Apple Team ID, and hardened
	  runtime library validation refuses to load a framework (Sparkle) without one. The rest of the
	  hardened runtime stays on.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
